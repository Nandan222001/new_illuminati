# Copy this file to .env and fill in real values. Never commit .env.

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=ib_app
DB_PASSWORD=change-me
DB_NAME=illuminati_brotherhood

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Seed admin (Grand Keeper) account created on first startup
ADMIN_EMAIL=admin@illuminati-brotherhood.org
ADMIN_PASSWORD=change-me

# Comma-separated list of origins allowed to call this API (e.g. the Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- E-book library uploads ----
# Where Keeper-uploaded PDF/EPUB volumes are stored. Relative paths resolve
# against backend/. Files are never served statically — members download them
# through /api/v1/library/files/{key}, which checks the paid flag.
UPLOAD_DIR=uploads
MAX_EBOOK_SIZE_MB=100

# ---- Local development without MySQL (optional) ----
# Uncomment both lines to run on a file-backed SQLite database instead of MySQL.
# Alembic remains the source of truth for MySQL/production.
# DATABASE_URL=sqlite:///./dev.db
# AUTO_CREATE_TABLES=true
