# Copy this file to .env and fill in real values. Never commit .env.

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=ib_app
DB_PASSWORD=change-me
DB_NAME=illuminati_brotherhood

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Seed admin (Grand Keeper) account created on first startup
ADMIN_EMAIL=admin@illuminati-brotherhood.io
ADMIN_PASSWORD=change-me

# Comma-separated list of origins allowed to call this API (e.g. the Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public frontend URL (links inside transactional mail)
SITE_URL=http://localhost:5173

# Initiation-letter delivery. Leave SMTP_HOST empty to render letters into
# MAIL_OUTBOX_DIR instead (handy locally and in CI).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Illuminati Brotherhood <no-reply@illuminati-brotherhood.io>
MAIL_OUTBOX_DIR=outbox
