# Canonical public origin for prerendered metadata, sitemap.xml and robots.txt.
# Set this to the exact primary production domain (without a trailing slash).
VITE_SITE_URL=https://illuminati-brotherhood.org

# Optional. Only needed to override the Vite dev proxy (see vite.config.js),
# e.g. when the backend isn't running on the same host during development.
# VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Should match the backend's ADMIN_EMAIL (see backend/.env) for the configured
# Keeper-login exception and the /login development demo. Member accounts are
# still restricted to supported consumer email providers.
VITE_ADMIN_EMAIL=admin@illuminati-brotherhood.org
VITE_ADMIN_PASSWORD=
