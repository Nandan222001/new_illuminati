# Optional. Only needed to override the Vite dev proxy (see vite.config.js),
# e.g. when the backend isn't running on the same host during development.
# VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Shown on the /login page's demo box. Should match the backend's
# ADMIN_EMAIL / ADMIN_PASSWORD (see backend/.env) so "fill admin credentials"
# actually signs in as the seeded Keeper account.
VITE_ADMIN_EMAIL=admin@illuminati-brotherhood.io
VITE_ADMIN_PASSWORD=
