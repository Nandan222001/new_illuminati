{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/symbols",
      "destination": "/visuals",
      "permanent": true
    },
    {
      "source": "/countdown",
      "destination": "/new-order",
      "permanent": true
    },
    {
      "source": "/new-world-order",
      "destination": "/new-order",
      "permanent": true
    },
    {
      "source": "/library",
      "destination": "/archives#library",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/archives/:slug([^/.]+)",
      "destination": "/catalogue-fallback"
    },
    {
      "source": "/videos/:slug([^/.]+)",
      "destination": "/catalogue-fallback"
    }
  ]
}
